[Unit]
Description=rpi-dashboard kiosk
Wants=network-online.target NetworkManager-wait-online.service
After=systemd-user-sessions.service plymouth-quit.service network-online.target NetworkManager-wait-online.service
Conflicts=getty@tty1.service
OnSuccess=getty@tty1.service

[Service]
Type=simple
User=dashboard
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=GITHUB_TOKEN_FILE=%d/github-token
Environment=OPENWEATHER_API_KEY_FILE=%d/openweather-api-key
Environment=IPGEOLOCATION_API_KEY_FILE=%d/ipgeolocation-api-key
LoadCredentialEncrypted=github-token
LoadCredentialEncrypted=openweather-api-key
LoadCredentialEncrypted=ipgeolocation-api-key
ExecStart=/usr/local/libexec/rpi-dashboard/run-kiosk.sh /usr/local/bin/rpi-dashboard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
