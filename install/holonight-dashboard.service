[Unit]
Description=HoloNight dashboard kiosk
After=systemd-user-sessions.service plymouth-quit.service
Conflicts=getty@tty1.service
OnSuccess=getty@tty1.service

[Service]
Type=simple
User=dashboard
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=GITHUB_TOKEN_FILE=%d/github-token
LoadCredentialEncrypted=github-token
ExecStart=/usr/local/libexec/holonight-dashboard/run-kiosk.sh /usr/local/bin/holonight-dashboard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
