set(config_directory
    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_SYSCONFDIR@/xdg/rpi-dashboard"
)
set(config_path "${config_directory}/config.toml")
set(default_config_path "@CMAKE_CURRENT_SOURCE_DIR@/install/config.toml")

file(MAKE_DIRECTORY "${config_directory}")

if(NOT EXISTS "${config_path}")
    file(COPY_FILE "${default_config_path}" "${config_path}")
    return()
endif()

file(READ "${config_path}" existing_config)
file(READ "${default_config_path}" default_config)
string(REPLACE "\r\n" "\n" default_config "${default_config}")
string(REPLACE "\n" ";" default_lines "${default_config}")

set(section_names)
set(current_section)
foreach(line IN LISTS default_lines)
    if(line MATCHES "^\\[([A-Za-z0-9_-]+)\\]$")
        set(current_section "${CMAKE_MATCH_1}")
        list(APPEND section_names "${current_section}")
    endif()
    if(current_section)
        string(APPEND section_${current_section} "${line}\n")
    endif()
endforeach()

foreach(section IN LISTS section_names)
    if(NOT existing_config MATCHES "(^|\n)[ \t]*\\[${section}\\][ \t]*(\r?\n|$)")
        if(existing_config AND NOT existing_config MATCHES "\n$")
            file(APPEND "${config_path}" "\n")
        endif()
        if(existing_config)
            file(APPEND "${config_path}" "\n")
        endif()
        file(APPEND "${config_path}" "${section_${section}}")
        string(APPEND existing_config "\n${section_${section}}")
    endif()
endforeach()
